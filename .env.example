# Copy this file to .env (which is gitignored) and fill in real values.
# docker-compose reads .env automatically for the ${VAR} substitutions below.

# HS256 signing key shared by lessor/renter/notification-service so any
# service can validate a token issued by another. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# AES-256-GCM key (32 raw bytes, base64-encoded) used by lessor-service to
# encrypt hostel_address.street/building_name_or_number and
# payment.transaction_id. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# ============================================================
# Production only (docker-compose.prod.yml) - not used by the local
# docker-compose.yml or by running services directly.
#
# Use a SEPARATE env file for these, e.g. .env.prod (also gitignored, same
# .env.* pattern) - generate fresh JWT_SECRET/FIELD_ENCRYPTION_KEY values for
# it too. Never reuse local-dev secrets for a publicly reachable deployment.
#   docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# ============================================================

# The domain your VM is reachable at (e.g. a free DuckDNS subdomain like
# myhostel.duckdns.org, or your own domain's A record pointed at the VM's
# public IP). Caddy uses this both to request a free Let's Encrypt cert and
# to build the frontend's API URLs at build time (see web/Dockerfile).
DOMAIN=
